# Copy to .env and fill in. Real environment variables override this file.
SLEEPER_USERNAME=          # required, used to resolve user_id
SLEEPER_LEAGUE_ID=         # required unless DRAFT_ID is set directly
SLEEPER_LEAGUE_IDS=        # optional; every league to offer, comma separated,
                           #   so `--league NAME` and the phone's league chips work
DRAFT_ID=                  # optional override; useful for mock drafts
ANTHROPIC_API_KEY=         # required for `recommend`, optional for `shortlist`
FFA_MODEL=                 # defaults to claude-sonnet-5
POLL_INTERVAL_SECONDS=3
RESEARCH_CONCURRENCY=4
RESEARCH_BUDGET=60         # max research calls per draft session, hard stop
FFA_WEB_TOKEN=             # optional; when set, `ffa serve` requires ?token=... from the phone
